  "cases": [
    {
      "id": "protocol-valid-composition-ref",
      "description": "Valid module composition using uses, a root $ref attachment point with a local child, and an $ref node.",
      "rustStatus": "supported",
      "protocolAuthorization": {
        "directives": [
          "uses",
          "$ref"
        ],
        "expectedStatusCode": 202,
        "definition": {
          "module": "http://example.com/comments",
          "published": true,
          "uses": {
            "threads": "http://example.com/threads"
          },
          "types": {
            "comment": {
              "schema": "http://schema.example.com/comment",
              "dataFormats": [
                "text/plain"
              ]
            }
          },
          "structure": {
            "thread": {
              "$ref": "threads:thread",
              "comment": {
                "$actions": [
                  {
                    "who": "anyone",
                    "can": [
                      "create",
                      "read"
                    ]
                  }
                ]
              }
            },
            "comment": {
              "$actions": [
                {
                  "who": "anyone",
                  "can": [
                    "create",
                    "read"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "id": "protocol-directives-role-tags-limits-delivery",
      "description": "Directives $role, $size, $tags, $recordLimit, $immutable, $delivery, and $squash. The $role path is rejected because upstream requires an authorized issuer for role records: 'anyone' cannot create or squash an initial role record.",
      "rustStatus": "supported",
      "protocolAuthorization": {
        "directives": [
          "$role",
          "$size",
          "$tags",
          "$recordLimit",
          "$immutable",
          "$delivery",
          "$squash"
        ],
        "expectedStatusCode": 400,
        "expectedErrorCode": "ModulesConfigureInvalidRoleIssuance",
        "definition": {
          "module": "http://example.com/tasks",
          "published": true,
          "types": {
            "adminRole": {
              "schema": "http://schema.example.com/admin-role",
              "dataFormats": [
                "application/json"
              ]
            },
            "task": {
              "schema": "http://schema.example.com/task",
              "dataFormats": [
                "application/json"
              ]
            }
          },
          "structure": {
            "adminRole": {
              "$role": true,
              "$actions": [
                {
                  "who": "anyone",
                  "can": [
                    "create"
                  ]
                }
              ]
            },
            "task": {
              "$actions": [
                {
                  "role": "adminRole",
                  "can": [
                    "create",
                    "read"
                  ]
                }
              ],
              "$size": {
                "min": 1,
                "max": 4096
              },
              "$tags": {
                "$requiredTags": [
                  "status"
                ],
                "$allowUndefinedTags": false,
                "status": {
                  "type": "string",
                  "enum": [
                    "open",
                    "closed"
                  ]
                },
                "priority": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                }
              },
              "$recordLimit": {
                "max": 100
              },
              "$immutable": true,
              "$delivery": "direct",
              "$squash": true
            }
          }
        }
      }
    },
    {
      "id": "protocol-valid-cross-protocol-role",
      "description": "Valid cross-protocol role reference using an alias declared in uses.",
      "rustStatus": "supported",
      "protocolAuthorization": {
        "directives": [
          "uses",
          "crossProtocolRole"
        ],
        "expectedStatusCode": 202,
        "definition": {
          "module": "http://example.com/projects",
          "published": true,
          "uses": {
            "team": "http://example.com/team"
          },
          "types": {
            "project": {
              "schema": "http://schema.example.com/project",
              "dataFormats": [
                "application/json"
              ]
            }
          },
          "structure": {
            "project": {
              "$actions": [
                {
                  "role": "team:member",
                  "can": [
                    "create",
                    "read"
                  ]
                }
              ]
            }
          }
        }
      }
    },
